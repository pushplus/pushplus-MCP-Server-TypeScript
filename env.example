# pushplus mcp server 环境配置示例文件
# 复制此文件为 .env 并填入您的实际配置
#
# PUSHPLUS_TOKEN：发送与开放接口共用
# PUSHPLUS_SECRET_KEY：调用 /open/** 时需要（需在官网开启开放接口）

# 用户 Token（32位，必需）
PUSHPLUS_TOKEN=your_pushplus_token_here

# 开放接口 secretKey
PUSHPLUS_SECRET_KEY=your_secret_key_here

# API 根地址
PUSHPLUS_BASE_URL=https://www.pushplus.plus

# 开放接口前缀（官方文档为 /api；/send 不走此前缀）
PUSHPLUS_OPEN_API_PREFIX=/api

# 可选配置
MCP_SERVER_NAME=pushplus-mcp-server
MCP_SERVER_VERSION=1.0.7
DEBUG=false

# 默认消息模板
# 可选: html/txt/json/markdown/cloudMonitor/jenkins/route/pay/order/verify/form/doc/excel/webdiff
DEFAULT_TEMPLATE=html

# 默认推送渠道
# 可选: wechat/webhook/cp/mail/sms/voice/extension/app/clawbot
DEFAULT_CHANNEL=wechat
